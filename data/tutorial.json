    "card_tutorial": {
        "id": "card_intro",
        "title": "卡牌系统说明",
        "steps": [
            {
                "id": "card_step_1_rarity",
                "title": "卡牌稀有度",
                "content": "卡牌分为三个稀有度：\n\n⭐⭐⭐ SSR - 效果强大，耐久较低（5次）\n⭐⭐ SR - 效果中等，耐久适中（8次）\n⭐ R - 基础卡牌，耐久充足（10次）\n\n稀有度越高，效果越强，但使用次数越少！",
                "highlight_element": "#card-gallery",
                "action": "continue"
            },
            {
                "id": "card_step_2_spectrum",
                "title": "光谱系统",
                "content": "每张卡牌都有自己的光谱属性：\n\n💻 技术光谱 - 对应RD员工\n🧪 服务光谱 - 对应QA员工\n🎨 设计光谱 - 对应设计师\n📊 运营光谱 - 对应运营人员\n\n合理搭配不同光谱的卡牌可以触发协同效果！",
                "highlight_element": "#spectrum-filter",
                "action": "continue"
            },
            {
                "id": "card_step_3_wear",
                "title": "卡牌磨损",
                "content": "⚠️ 重要提醒：卡牌有耐久度限制！\n\n🔧 使用卡牌会消耗耐久\n💔 耐久耗尽卡牌报废\n♻️ 报废可获得碎片\n🛒 50碎片可兑换R卡\n\n卡牌是消耗品，请谨慎使用！",
                "highlight_element": "#durability-display",
                "action": "continue"
            }
        ]
    },
